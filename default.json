{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Org-wide Renovate preset. Repos extend with: github>monumental-archive/.github",
  "extends": [
    "config:best-practices",
    ":dependencyDashboard"
  ],
  "minimumReleaseAge": "7 days",
  "packageRules": [
    {
      "description": "Routine updates merge themselves once aged and green; majors always get a human.",
      "matchUpdateTypes": [
        "patch",
        "minor",
        "pin",
        "digest",
        "pinDigest"
      ],
      "automerge": true
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "commitBody": "Signed-off-by: renovate[bot] <29139614+renovate[bot]@users.noreply.github.com>"
}
