# Do not fill this by hand: run `mise run fix:citation` and commit the
# render. Every field except two is derived — licence, authors and
# repository-code from REUSE.toml, version and date-released stamped by
# the release pipeline, the rest constants. The two human fields are
# `title` and, after the first DOI-minting release, the CONCEPT DOI
# under `identifiers:` (the run's summary prints it). lint:citation
# reddens hand drift, and requires this file wherever the release stub
# passes `mint-doi: true` (#316). No belt tool needed: the file is
# generated, so the generator is its own validator (tooling-verdicts).
cff-version: 1.2.0
message: If you use this software, please cite it using these metadata.
title: <run fix:citation>
type: software
authors:
  - family-names: <derived from REUSE.toml SPDX-PackageSupplier>
    given-names: <derived>
repository-code: <derived from REUSE.toml SPDX-PackageDownloadLocation>
license: <derived from REUSE.toml SPDX-License-Identifier>
version: <stamped by the release pipeline>
date-released: "<stamped by the release pipeline>"
