{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "files": {
    "includes": ["**", "!**/.claude", "!**/.git", "!**/node_modules"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "rules": {
      "preset": "all"
    }
  },
  "assist": {
    "actions": {
      "preset": "all",
      "source": {
        "useSortedKeys": "off"
      }
    }
  }
}
