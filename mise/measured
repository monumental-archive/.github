#!/usr/bin/env bash
# Run a repository's test command, measured where it runs (#1667).
#
#   "${ORG_BELT_DIR}/measured" <command> [<argument>…]
#
# The repository's `test` task names its command through this script,
# and nothing else interposes: the measurement is applied by the
# command line that runs the suite, in whatever task, shell, file task
# or script that line sits in. It execs its arguments, so the exit
# status and the signals are the command's own.
#
# With no `.coverage-floor` at the repository root, or outside a run
# that has a measurement directory (ORG_COVERAGE_RUN, set by the belt's
# `[env]` for every task of one `mise run`), it is `exec "$@"` and
# nothing else: the environment reaches the command unchanged. The floor
# file's EXISTENCE is the switch, whatever it holds: coverage:adopt
# measures a tree adopting for the first time by creating it empty
# before the suite runs.
#
# With both, it first EXTENDS the environment the command really has,
# merging and never replacing (#1667 item 2), because a variable the
# command's task set is the repository's:
#
#   python   a pytest run (`pytest …` or `<python> -m pytest …`) is
#            rewritten to run under coverage, from the pytest tool
#            venv, into the run's directory; any other command
#            measures no Python (#2177).
#   plpgsql  ORG_PLPGSQL_COVERAGE names the directory, in the run's,
#            where each of the suite's teardowns writes its database's
#            report, one file per database (#2163).
#   go       in a tree with go.mod, GOFLAGS gains the cover flags and
#            `-exec=<belt>/go-test-exec`, and GOCOVERDIR names the run's
#            directory, so every test binary writes its counters there
#            (#1651).
#   rust     in a tree with Cargo.toml, CARGO_TARGET_DIR names a directory
#            of the measurement's own and what `cargo llvm-cov show-env`
#            prints for it is exported (rust-coverage-env.sh), so every
#            cargo the command starts is instrumented there; the first
#            call in the run removes the workspace's own artifacts and
#            the profiles earlier runs left (#1653, #2061).
#
# Then, where vitest is the tree's runner, it READS its own arguments
# (#2105): vitest's coverage has no environment switch, so the
# measurement is a few flags on the run's own command line.
#
#   typescript  in a tree with a tracked root lockfile that pins vitest
#            and exactly one coverage provider, the first argument whose
#            basename is `vitest`, with only a package manager's launcher
#            before it, is the run: `run` is inserted where it has no
#            subcommand, and the provider, the json-summary and lcov
#            reporters and a reports directory in the run's directory
#            are appended (coverage_js_runner.py reads the command). A
#            vitest subcommand other than `run`, or no vitest argument,
#            leaves the command unchanged. A `--coverage` argument of the
#            command's own is refused by name, and so is a second vitest
#            run in one test run: the leg measures one suite.
#
# go.mod, Cargo.toml and the lockfile are asked of git, as every belt
# task asks whether a file is the repository's (#2013): a file on disk
# that git does not track is no answer. The floor is not: coverage:adopt
# creates it untracked on purpose.
#
# coverage:check reads the run directory after `test` ends. A
# repository whose suite does not run through this script leaves no
# data there, and its floor's record names the leg that measured
# nothing (#1666).
set -euo pipefail

if [[ $# -eq 0 ]]; then
  cat >&2 << 'USAGE'
measured: no command — usage: "${ORG_BELT_DIR}/measured" <test command> [<argument>…]
USAGE
  exit 2
fi

# A SHARD FIRST (#2160): with ORG_SHARD naming one other than 1/1, the
# command's runner is handed this shard's share in its own terms (vitest
# `--shard`, nextest `--partition`, a share of `go test`'s packages), and
# the shard's report is written for the gate's union check; any other
# command goes as it is (a setup line, or a belt runner that reads
# ORG_SHARD itself). shard_runner.py reads the command and prints it
# back, NUL-separated. Before the floor's switch: a share is not
# coverage.
if [[ -n ${ORG_SHARD:-} && ${ORG_SHARD} != 1/1 ]]; then
  : "${ORG_PYTHON:?unset — the belt Python (CI: the canon action; local: the belt [env])}"
  shard_argv=$(mktemp)
  "${ORG_PYTHON}" -I "$(dirname "${BASH_SOURCE[0]}")/../belt" shard-runner -- "$@" > "${shard_argv}" || {
    rm -f -- "${shard_argv}"
    exit 1
  }
  words=()
  while IFS= read -r -d '' word; do
    words+=("${word}")
  done < "${shard_argv}"
  rm -f -- "${shard_argv}"
  set -- "${words[@]}"
fi

run=${ORG_COVERAGE_RUN:-}
root=""
if [[ -n ${run} ]]; then
  root=$(git rev-parse --show-toplevel 2> /dev/null) || root=""
fi
if [[ -z ${run} || -z ${root} || ! -f ${root}/.coverage-floor ]]; then
  exec "$@"
fi

belt=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

# Whether a file is the repository's, asked of git with the path from
# the root, so the answer is the same from any directory the command
# runs in (#2013).
# shellcheck source=mise/tracked.sh
. "${belt}/tracked.sh"

# The first call in a run clears what earlier runs left: the sweep and
# why it is needed are coverage-run.sh's.
# shellcheck source=mise/coverage-run.sh
. "${belt}/coverage-run.sh"
[[ -d ${run} ]] || org_coverage_sweep "${run}"
mkdir -p "${run}"

# python: a pytest run, measured where it runs (#2177). The belt keeps
# no start-up hook: no belt Python runs in a test's child, so the run
# that holds the suite is the measurement. The command's first word is
# read: `pytest`, or a Python (`python`, `python3`, `python3.N`, or a
# path to one) followed by `-m pytest`, is rewritten to the pytest tool
# venv's interpreter running
#
#   -m coverage run --rcfile=<the run's rc file> -m pytest <the rest>
#
# so every argument after pytest is the command's own. Any other
# command, Python or not, runs as it is and measures no Python:
# coverage:check then names the leg that measured nothing, and its
# remedy names this script.
#
# The venv's interpreter must be the one the suite runs on: the tracer
# is a compiled extension, and a venv built on another Python would be
# testing another interpreter, silently. Asked once per call, of the
# belt's one check (tool_python.py, #1788).
#
# The rc file is written once per run, whole and renamed into place, so
# a call beside the first reads a complete file or writes its own
# identical one. Branches from the start (#1336 property 2). Test files
# are omitted: a suite executes itself completely by construction, and
# counting it would raise the number without one more line of the code
# under test being run. relative_files, so the report's paths are the
# repository's own and Codecov maps them without a fix-up. `patch =
# subprocess` measures the suite's own Python workers (pytest-xdist's),
# which run the venv's interpreter; coverage-measure.sh reads the run
# with the same file.
py_skip=0
case "${1:-}" in
  pytest | */pytest) py_skip=1 ;;
  python | python3 | python3.* | */python | */python3 | */python3.*)
    if [[ ${2:-} == -m && ${3:-} == pytest ]]; then
      py_skip=3
    fi
    ;;
  *) ;;
esac
if ((py_skip > 0)); then
  : "${ORG_PYTHON:?unset — the belt Python (CI: the canon action; local: the belt [env])}"
  py_venv=$("${ORG_PYTHON}" -I "${belt%/*}/belt" tool-python measured pytest) || exit 1
  if [[ ! -f ${run}/coverage.rc ]]; then
    mkdir -p "${run}/python"
    cat > "${run}/coverage.rc.$$" << RC
[run]
branch = true
parallel = true
patch = subprocess
source = ${root}
data_file = ${run}/python/.coverage
relative_files = true
omit = */test_*.py
disable_warnings = no-data-collected, module-not-measured

[report]
precision = 2
RC
    mv -f "${run}/coverage.rc.$$" "${run}/coverage.rc"
  fi
  shift "${py_skip}"
  set -- "${py_venv}" -m coverage run --rcfile="${run}/coverage.rc" -m pytest "$@"
fi

# go: the measurement, merged into the command's own environment (#1651).
# GOFLAGS gains `-cover -coverpkg=./... -covermode=atomic` and
# `-exec=<belt>/go-test-exec`, and GOCOVERDIR names the run's `go`
# directory: every test binary `go test` starts writes its counters there
# through go-test-exec, from any number of `go test` runs, and the go leg
# merges them with `go tool covdata`. -coverpkg=./... (#652): a statement
# only a neighbouring package's tests run is still covered. -covermode=
# atomic: Go refuses `set` under -race. Commands that are not `go test`
# ignore the flags (measured: go build, vet and list exit 0).
#
# A test command that measures itself another way would replace what this
# rests on: a flag on the command line wins over GOFLAGS (measured), and a
# GOCOVERDIR of its own would take the counters elsewhere. So its own
# -cover, -coverprofile, -coverpkg, -covermode or -exec, on a `go test` in
# this command or already in GOFLAGS, and a GOCOVERDIR already set, are
# refused here by name, before anything runs.
refuse_go() { # usage: refuse_go <where> <what>
  echo "measured: $2 $1, which would measure Go a second way or" >&2
  echo "  replace the measurement's own (#1651); drop it: the go leg measures every" >&2
  echo "  go test with -cover -coverpkg=./... -covermode=atomic into the run" >&2
  exit 1
}
refuse_cover_flag() { # usage: refuse_cover_flag <where> <word>; refuses a measuring flag
  # One dash or two: go takes either spelling of a flag.
  local flag=${2#-}
  case "-${flag#-}" in
    -cover | -cover=* | -coverprofile | -coverprofile=* | -coverpkg | -coverpkg=*) refuse_go "$1" "$2" ;;
    -covermode | -covermode=* | -exec | -exec=*) refuse_go "$1" "$2" ;;
    *) ;;
  esac
}
if org_tracked_has "${root}/go.mod"; then
  if [[ -n ${GOCOVERDIR:-} ]]; then
    refuse_go "is set (GOCOVERDIR=${GOCOVERDIR})" "the environment's GOCOVERDIR"
  fi
  read -ra words <<< "${GOFLAGS:-}"
  for word in ${words[@]+"${words[@]}"}; do
    refuse_cover_flag "is in GOFLAGS" "${word}"
  done
  # The words of each argument, read the way a shell would split them: a
  # go test starts a span that ends at `-args` (the test's own
  # arguments follow) or at a command separator.
  prev="" in_test=""
  for arg in "$@"; do
    read -ra words <<< "${arg}"
    for word in ${words[@]+"${words[@]}"}; do
      case "${word}" in
        ";" | "&&" | "||" | "|" | -args) in_test="" ;;
        test) [[ ${prev##*/} != go ]] || in_test=1 ;;
        *)
          if [[ -n ${in_test} ]]; then
            refuse_cover_flag "on its go test" "${word}"
          fi
          ;;
      esac
      [[ ${word} != *";" ]] || in_test=""
      prev=${word}
    done
  done
  # GOFLAGS is split on spaces and takes no quoting (go help environment).
  if [[ ${run} == *" "* || ${belt} == *" "* ]]; then
    echo "measured: '${run}' or '${belt}' holds a space, which GOFLAGS cannot carry" >&2
    exit 1
  fi
  mkdir -p "${run}/go"
  export GOCOVERDIR="${run}/go"
  cover="-cover -coverpkg=./... -covermode=atomic -exec=${belt}/go-test-exec"
  export GOFLAGS="${GOFLAGS:+${GOFLAGS} }${cover}"
fi

# rust: the repository's own command, instrumented (#1653). CARGO_TARGET_DIR
# names `<target_directory>/llvm-cov-target-<digest of rustc -vV>` (#1877)
# and what `cargo llvm-cov show-env` prints for it is exported, in that
# order (rust-coverage-env.sh, shared with the rust leg, says why): every
# cargo the command starts builds instrumented into that directory and
# writes its profiles there, from any number of cargo runs, features,
# doctests and all. The rust leg renders them with `cargo llvm-cov
# report` and builds nothing.
#
# The instrumentation rides RUSTC_WRAPPER and LLVM_PROFILE_FILE, in a
# target directory of its own. A test command that sets any of the three
# would replace what this rests on, and one that runs `cargo llvm-cov`
# measures itself a second way: each is refused here by name, before
# anything runs.
refuse_rust() { # usage: refuse_rust <what>
  echo "measured: $1, which would measure Rust a second way or" >&2
  echo "  replace the measurement's own (#1653); drop it: the rust leg measures every" >&2
  echo "  cargo the test command starts, instrumented into a target directory of its own" >&2
  exit 1
}
if org_tracked_has "${root}/Cargo.toml"; then
  for name in CARGO_TARGET_DIR RUSTC_WRAPPER LLVM_PROFILE_FILE; do
    if [[ -n ${!name:-} ]]; then
      refuse_rust "the environment's ${name} is set (${name}=${!name})"
    fi
  done
  # The words of each argument, read the way a shell would split them: a
  # `cargo` (a `+toolchain` may follow it) then `llvm-cov`, or the
  # subcommand's own binary.
  prev=""
  for arg in "$@"; do
    read -ra words <<< "${arg}"
    for word in ${words[@]+"${words[@]}"}; do
      case "${word##*/}" in
        cargo-llvm-cov) refuse_rust "${word} is in the test command" ;;
        llvm-cov) [[ ${prev##*/} != cargo ]] || refuse_rust "cargo llvm-cov is in the test command" ;;
        *) ;;
      esac
      [[ ${word} == +* ]] || prev=${word}
    done
  done
  # shellcheck source=mise/rust-coverage-env.sh
  . "${belt}/rust-coverage-env.sh"
  org_rust_coverage_env measured
  # The build directory is the checkout's, the run is this process's: two
  # runs measuring at once in one checkout would clean and read each
  # other's directory (#2062). Every call claims it before anything is
  # cleaned or built, and a live other run's claim ends this one, by name.
  "${ORG_PYTHON}" -I "${belt%/*}/belt" coverage-owner claim "${CARGO_TARGET_DIR}" "${run}" || exit 1
  # The workspace's own artifacts and old profiles go once per run, by its
  # first call (#2061): `report` reads every workspace executable in the
  # directory, so one an earlier build left and this run did not overwrite
  # (a version bump renames them all) joins the figure with zero hits, and
  # a restored cache or an earlier run cannot add its profiles. Dependencies
  # stay built. once.py runs the clean under a lock on the run's marker, so
  # a second call in the same run keeps the first one's work, and a call
  # starting beside the first waits for its clean to finish rather than
  # building into a directory the clean is emptying. A clean cargo refused
  # is red by name: cargo-llvm-cov reports it as a warning (#2070).
  "${ORG_PYTHON}" -I "${belt%/*}/belt" once "${run}/rust" -- \
    "${ORG_PYTHON}" -I "${belt%/*}/belt" coverage-owner clean >&2 || exit 1
fi

# plpgsql: one directory per run, one report in it per database the
# suite tears down (#2163); a value already set is kept. The teardown's
# collect creates it, so a run that collected nothing leaves none.
export ORG_PLPGSQL_COVERAGE="${ORG_PLPGSQL_COVERAGE:-${run}/plpgsql-coverage}"

# typescript: the run's own vitest, measured where it runs (#2105). The
# runner and the provider are the tracked root lockfile's, read by
# coverage_js_runner.py, which also reads the command: it prints the
# vitest run with the leg's flags, NUL-separated, or nothing when the
# command is not one, and refuses a coverage flag of the command's own.
# The reports go to the run's `typescript` directory, made without -p:
# one there already is a second vitest run in this test run, refused by
# name, because two suites cannot be one figure.
js=()
for name in package.json pnpm-lock.yaml package-lock.json yarn.lock bun.lock; do
  if org_tracked_has "${root}/${name}"; then
    js+=("${name}")
  fi
done
if [[ ${js[0]:-} == package.json && -n ${js[1]+set} ]]; then
  : "${ORG_PYTHON:?unset — the belt Python (CI: the canon action; local: the belt [env])}"
  ts_dir="${run}/typescript"
  ts_argv="${run}/vitest-argv.$$"
  (cd "${root}" && "${ORG_PYTHON}" -I "${belt%/*}/belt" coverage-js-runner \
    measured-run "${ts_dir}" --tracked "${js[@]}" -- "$@") > "${ts_argv}" || {
    rm -f -- "${ts_argv}"
    exit 1
  }
  if [[ -s ${ts_argv} ]]; then
    if ! mkdir "${ts_dir}" 2> /dev/null; then
      rm -f -- "${ts_argv}"
      if [[ -e ${ts_dir} ]]; then
        echo "measured: a second vitest run in one test run (${ts_dir} exists):" >&2
        echo "  the leg measures one suite; a repository with several uses vitest projects" >&2
        exit 1
      fi
      mkdir "${ts_dir}"
      exit 1
    fi
    words=()
    while IFS= read -r -d '' word; do
      words+=("${word}")
    done < "${ts_argv}"
    rm -f -- "${ts_argv}"
    set -- "${words[@]}"
  else
    rm -f -- "${ts_argv}"
  fi
fi

exec "$@"
