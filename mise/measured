#!/usr/bin/env bash
# Run a repository's test command, measured where it runs (#1667).
#
#   "${ORG_BELT_DIR}/measured" <command> [<argument>…]
#
# The repository's `test` task names its command through this script,
# and nothing else interposes: the measurement is applied by the
# command line that runs the suite, in whatever task, shell, file task
# or script that line sits in. It execs its arguments, so the exit
# status and the signals are the command's own.
#
# With no `.coverage-floor` at the repository root, or outside a run
# that has a measurement directory (ORG_COVERAGE_RUN, set by the belt's
# `[env]` for every task of one `mise run`), it is `exec "$@"` and
# nothing else: the environment reaches the command unchanged. The floor
# file's EXISTENCE is the switch, whatever it holds: coverage:adopt
# measures a tree adopting for the first time by creating it empty
# before the suite runs.
#
# With both, it first EXTENDS the environment the command really has,
# merging and never replacing (#1667 item 2), because a variable the
# command's task set is the repository's:
#
#   python   the run's start-up hook is put in front of PYTHONPATH,
#            beside what is there, and COVERAGE_PROCESS_START names the
#            run's rc file; every python3 the command starts is
#            measured into the run's directory.
#   plpgsql  ORG_PLPGSQL_COVERAGE names the report the suite's teardown
#            writes, in the run directory.
#   go       in a tree with go.mod, GOFLAGS gains the cover flags and
#            `-exec=<belt>/go-test-exec`, and GOCOVERDIR names the run's
#            directory, so every test binary writes its counters there
#            (#1651).
#   rust     in a tree with Cargo.toml, CARGO_TARGET_DIR names a directory
#            of the measurement's own and what `cargo llvm-cov show-env`
#            prints for it is exported (rust-coverage-env.sh), so every
#            cargo the command starts is instrumented there; the first
#            call in the run removes the workspace's own artifacts and
#            the profiles earlier runs left (#1653, #2061).
#
# coverage:check reads the run directory after `test` ends. A
# repository whose suite does not run through this script leaves no
# data there, and its floor's record names the leg that measured
# nothing (#1666).
set -euo pipefail

if [[ $# -eq 0 ]]; then
  cat >&2 << 'USAGE'
measured: no command — usage: "${ORG_BELT_DIR}/measured" <test command> [<argument>…]
USAGE
  exit 2
fi

run=${ORG_COVERAGE_RUN:-}
root=""
if [[ -n ${run} ]]; then
  root=$(git rev-parse --show-toplevel 2> /dev/null) || root=""
fi
if [[ -z ${run} || -z ${root} || ! -f ${root}/.coverage-floor ]]; then
  exec "$@"
fi

belt=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

# The first call in a run clears what earlier runs left: the sweep and
# why it is needed are coverage-run.sh's.
# shellcheck source=mise/coverage-run.sh
. "${belt}/coverage-run.sh"
[[ -d ${run} ]] || org_coverage_sweep "${run}"
mkdir -p "${run}"

# python: a start-up hook and an rc file, written into the run's
# directory by the first call in the run and read by every later one.
#
# The hook is written by the belt's one hook writer (startup_hook.py,
# #1542), which appends the chain to the next sitecustomize on the path,
# so a repository's own hook and the mutation leg's still run. Its work
# is coverage's own start-up, from the directory the coverage package is
# imported from, appended to sys.path so the suite's imports resolve as
# they do unmeasured. The rc file names this run's data file and the
# repository's root; coverage-measure.sh reads the run with it.
#
# The tool venv's interpreter must be the one the suite runs on: the
# tracer is a compiled extension, and a venv built on another Python
# would load in no child, silently. Asked once per run, of the belt's
# one check (tool_python.py, #1788), which also names the directory the
# coverage package is imported from.
#
# Each file is written whole and renamed into place, the rc file last,
# so a call running beside the first reads complete files or writes
# its own identical ones.
if command -v coverage > /dev/null; then
  if [[ ! -f ${run}/coverage.rc ]]; then
    : "${ORG_PYTHON:?unset — the belt Python (CI: the canon action; local: the belt [env])}"
    cov_site=$("${ORG_PYTHON}" "${belt}/tool_python.py" measured coverage --site coverage) || exit 1
    site=$("${ORG_PYTHON}" -c 'import sys; print(repr(sys.argv[1]))' "${cov_site}")
    mkdir -p "${run}/hook" "${run}/python"
    printf 'import sys\nsys.path.append(%s)\nimport coverage\ncoverage.process_startup()\n' \
      "${site}" | "${ORG_PYTHON}" "${belt}/startup_hook.py" "${run}/hook.$$"
    mv -f "${run}/hook.$$/sitecustomize.py" "${run}/hook/sitecustomize.py"
    rmdir "${run}/hook.$$"
    # Branches from the start (#1336 property 2). Test files are omitted:
    # a suite executes itself completely by construction, and counting it
    # would raise the number without one more line of the code under
    # test being run. relative_files, so the report's paths are the
    # repository's own and Codecov maps them without a fix-up.
    cat > "${run}/coverage.rc.$$" << RC
[run]
branch = true
parallel = true
source = ${root}
data_file = ${run}/python/.coverage
relative_files = true
omit = */test_*.py
disable_warnings = no-data-collected, module-not-measured

[report]
precision = 2
RC
    mv -f "${run}/coverage.rc.$$" "${run}/coverage.rc"
  fi
  export COVERAGE_PROCESS_START="${run}/coverage.rc"
  case ":${PYTHONPATH:-}:" in
    *":${run}/hook:"*) ;;
    *) export PYTHONPATH="${run}/hook${PYTHONPATH:+:${PYTHONPATH}}" ;;
  esac
fi

# go: the measurement, merged into the command's own environment (#1651).
# GOFLAGS gains `-cover -coverpkg=./... -covermode=atomic` and
# `-exec=<belt>/go-test-exec`, and GOCOVERDIR names the run's `go`
# directory: every test binary `go test` starts writes its counters there
# through go-test-exec, from any number of `go test` runs, and the go leg
# merges them with `go tool covdata`. -coverpkg=./... (#652): a statement
# only a neighbouring package's tests run is still covered. -covermode=
# atomic: Go refuses `set` under -race. Commands that are not `go test`
# ignore the flags (measured: go build, vet and list exit 0).
#
# A test command that measures itself another way would replace what this
# rests on: a flag on the command line wins over GOFLAGS (measured), and a
# GOCOVERDIR of its own would take the counters elsewhere. So its own
# -cover, -coverprofile, -coverpkg, -covermode or -exec, on a `go test` in
# this command or already in GOFLAGS, and a GOCOVERDIR already set, are
# refused here by name, before anything runs.
refuse_go() { # usage: refuse_go <where> <what>
  echo "measured: $2 $1, which would measure Go a second way or" >&2
  echo "  replace the measurement's own (#1651); drop it: the go leg measures every" >&2
  echo "  go test with -cover -coverpkg=./... -covermode=atomic into the run" >&2
  exit 1
}
refuse_cover_flag() { # usage: refuse_cover_flag <where> <word>; refuses a measuring flag
  # One dash or two: go takes either spelling of a flag.
  local flag=${2#-}
  case "-${flag#-}" in
    -cover | -cover=* | -coverprofile | -coverprofile=* | -coverpkg | -coverpkg=*) refuse_go "$1" "$2" ;;
    -covermode | -covermode=* | -exec | -exec=*) refuse_go "$1" "$2" ;;
    *) ;;
  esac
}
if [[ -f ${root}/go.mod ]]; then
  if [[ -n ${GOCOVERDIR:-} ]]; then
    refuse_go "is set (GOCOVERDIR=${GOCOVERDIR})" "the environment's GOCOVERDIR"
  fi
  read -ra words <<< "${GOFLAGS:-}"
  for word in ${words[@]+"${words[@]}"}; do
    refuse_cover_flag "is in GOFLAGS" "${word}"
  done
  # The words of each argument, read the way a shell would split them: a
  # go test starts a span that ends at `-args` (the test's own
  # arguments follow) or at a command separator.
  prev="" in_test=""
  for arg in "$@"; do
    read -ra words <<< "${arg}"
    for word in ${words[@]+"${words[@]}"}; do
      case "${word}" in
        ";" | "&&" | "||" | "|" | -args) in_test="" ;;
        test) [[ ${prev##*/} != go ]] || in_test=1 ;;
        *)
          if [[ -n ${in_test} ]]; then
            refuse_cover_flag "on its go test" "${word}"
          fi
          ;;
      esac
      [[ ${word} != *";" ]] || in_test=""
      prev=${word}
    done
  done
  # GOFLAGS is split on spaces and takes no quoting (go help environment).
  if [[ ${run} == *" "* || ${belt} == *" "* ]]; then
    echo "measured: '${run}' or '${belt}' holds a space, which GOFLAGS cannot carry" >&2
    exit 1
  fi
  mkdir -p "${run}/go"
  export GOCOVERDIR="${run}/go"
  cover="-cover -coverpkg=./... -covermode=atomic -exec=${belt}/go-test-exec"
  export GOFLAGS="${GOFLAGS:+${GOFLAGS} }${cover}"
fi

# rust: the repository's own command, instrumented (#1653). CARGO_TARGET_DIR
# names `<target_directory>/llvm-cov-target-<digest of rustc -vV>` (#1877)
# and what `cargo llvm-cov show-env` prints for it is exported, in that
# order (rust-coverage-env.sh, shared with the rust leg, says why): every
# cargo the command starts builds instrumented into that directory and
# writes its profiles there, from any number of cargo runs, features,
# doctests and all. The rust leg renders them with `cargo llvm-cov
# report` and builds nothing.
#
# The instrumentation rides RUSTC_WRAPPER and LLVM_PROFILE_FILE, in a
# target directory of its own. A test command that sets any of the three
# would replace what this rests on, and one that runs `cargo llvm-cov`
# measures itself a second way: each is refused here by name, before
# anything runs.
refuse_rust() { # usage: refuse_rust <what>
  echo "measured: $1, which would measure Rust a second way or" >&2
  echo "  replace the measurement's own (#1653); drop it: the rust leg measures every" >&2
  echo "  cargo the test command starts, instrumented into a target directory of its own" >&2
  exit 1
}
if [[ -f ${root}/Cargo.toml ]]; then
  for name in CARGO_TARGET_DIR RUSTC_WRAPPER LLVM_PROFILE_FILE; do
    if [[ -n ${!name:-} ]]; then
      refuse_rust "the environment's ${name} is set (${name}=${!name})"
    fi
  done
  # The words of each argument, read the way a shell would split them: a
  # `cargo` (a `+toolchain` may follow it) then `llvm-cov`, or the
  # subcommand's own binary.
  prev=""
  for arg in "$@"; do
    read -ra words <<< "${arg}"
    for word in ${words[@]+"${words[@]}"}; do
      case "${word##*/}" in
        cargo-llvm-cov) refuse_rust "${word} is in the test command" ;;
        llvm-cov) [[ ${prev##*/} != cargo ]] || refuse_rust "cargo llvm-cov is in the test command" ;;
        *) ;;
      esac
      [[ ${word} == +* ]] || prev=${word}
    done
  done
  # shellcheck source=mise/rust-coverage-env.sh
  . "${belt}/rust-coverage-env.sh"
  org_rust_coverage_env measured
  # The workspace's own artifacts and old profiles go once per run, by its
  # first call (#2061): `report` reads every workspace executable in the
  # directory, so one an earlier build left and this run did not overwrite
  # (a version bump renames them all) joins the figure with zero hits, and
  # a restored cache or an earlier run cannot add its profiles. Dependencies
  # stay built. once.py runs the clean under a lock on the run's marker, so
  # a second call in the same run keeps the first one's work, and a call
  # starting beside the first waits for its clean to finish rather than
  # building into a directory the clean is emptying.
  "${ORG_PYTHON}" "${belt}/once.py" "${run}/rust" -- cargo llvm-cov clean --workspace >&2 || exit 1
fi

# plpgsql: one report per run; a value already set is kept.
export ORG_PLPGSQL_COVERAGE="${ORG_PLPGSQL_COVERAGE:-${run}/plpgsql-coverage.json}"

exec "$@"
