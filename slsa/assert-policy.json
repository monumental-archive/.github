{
  "schema": 6,
  "issuer": "https://token.actions.githubusercontent.com",
  "debtFile": "security/attestation-debt.txt",
  "population": {
    "repositories": [
      { "repo": ".github" },
      { "repo": "release-lab" },
      { "repo": "stele" },
      { "repo": "iiif-server" },
      {
        "repo": "signer",
        "tracks": ["source"],
        "reason": "publishes no releases; it is the signing workflow repository"
      },
      {
        "repo": "monumental-archive",
        "tracks": [],
        "reason": "excluded, not excepted: the private application the organisation exists to serve publishes nothing and consumes the org's artifacts, so no SLSA track applies, it owes no evidence and it bears no board cell — it is accounted for by name here so the reconciliation against the org listing does not read it as an unlisted repository, and so the roster-reading walks that ask no track question (assert permissions) still cover it (#672)"
      },
      {
        "repo": "monumental-archive-ledger",
        "tracks": [],
        "reason": "excluded, not excepted: the public anchor for the archive's ledger checkpoint chain publishes no artifact and makes no SLSA claim, so no track applies and it bears no board cell — it is accounted for by name here so the reconciliation against the org listing does not read it as an unlisted repository (#673)"
      }
    ]
  },
  "evidence": {
    "sbomSuffix": ".spdx.json",
    "checksums": "checksums.txt",
    "umbrellaBundle": "attestations.intoto.jsonl",
    "manifestAsset": "evidence-manifest.json",
    "storeVsaFromVersion": "1.13.0",
    "decisionFromVersion": "1.23.1",
    "evidenceSuffixes": [".openvex.json"],
    "publishWorkflows": ["publish", "self-publish"],
    "classes": {
      "rust-crate": {
        "bundles": ["attestations-crates.intoto.jsonl"],
        "legacyVsaBundles": ["attestations-vsa-crates.intoto.jsonl"],
        "assetPrefixes": [
          { "prefix": "sbom-cargo-", "owedFrom": "1.42.0", "planned": true }
        ]
      },
      "oci-image": {
        "bundles": ["attestations-image.intoto.jsonl"]
      },
      "rust-binary": {
        "bundles": ["attestations-binaries.intoto.jsonl"],
        "assetPrefixes": [
          { "prefix": "sbom-cargo-", "owedFrom": "1.43.0", "planned": true }
        ]
      },
      "go-binary": {
        "bundles": ["attestations-go-binaries.intoto.jsonl"]
      },
      "source-archive": {
        "bundles": ["attestations-source.intoto.jsonl"]
      },
      "wasm-npm": {
        "bundles": ["attestations-npm.intoto.jsonl"],
        "legacyVsaBundles": ["attestations-vsa-npm.intoto.jsonl"],
        "assetPrefixes": [
          { "prefix": "sbom-npm-", "owedFrom": "1.42.0", "planned": true }
        ]
      },
      "pgrx-extension": {
        "bundles": ["attestations-extensions.intoto.jsonl"],
        "assetPrefixes": [
          { "prefix": "attestations-extimg-pg" },
          { "prefix": "sbom-pgrx-", "owedFrom": "1.42.0", "planned": true }
        ],
        "enrichment": ["pgrx-base-images", "pgrx-base"]
      }
    },
    "continuous": {
      "stubPath": ".github/workflows/continuous.yml",
      "stubUses": "monumental-archive/.github/",
      "registry": "ghcr.io",
      "tag": "latest",
      "signerWorkflow": "monumental-archive/signer/.github/workflows/sign.yml",
      "signerPinPattern": "monumental-archive/signer/.github/workflows/sign\\.yml@([0-9a-f]{40})"
    },
    "baseImages": {
      "pinFile": "docker/pgrx-base-images.toml",
      "attestorRepo": ".github",
      "attestorIdentity": "https://github.com/monumental-archive/.github/.github/workflows/base-attest.yml@refs/heads/main",
      "predicateType": "https://monumental-archive.github.io/attestations/base-image-approval/v1"
    },
    "enrichmentFromVersion": "1.41.0",
    "manifestSchemaFromVersion": "1.51.0"
  },
  "tags": {
    "tagPattern": "^v[0-9]",
    "taggerName": "tag-mint[bot]",
    "identityPattern": "^https://github\\.com/monumental-archive/",
    "proofFloor": {
      "floor": "observer-timestamp",
      "from": {
        ".github": "v1.46.0",
        "release-lab": "v0.25.4"
      },
      "before": "certificate-transparency"
    },
    "notesRef": "refs/notes/commits",
    "epochs": {
      ".github": "v1.23.1",
      "iiif-server": "v0.2.0",
      "release-lab": "v0.24.2",
      "stele": "v0.1.0"
    }
  },
  "chains": {
    "exceptions": []
  },
  "permissions": {
    "reusable": {
      "repo": "monumental-archive/.github",
      "dir": ".github/workflows"
    },
    "callerDirs": [".github/workflows", "workflow-templates"]
  },
  "blastRadius": {
    "osEcosystems": ["debian", "alpine", "ubuntu", "rocky", "redhat", "rpm"],
    "canary": {
      "repo": "release-lab",
      "tag": "v0.17.0",
      "advisory": "RUSTSEC-2021-0127"
    }
  }
}
